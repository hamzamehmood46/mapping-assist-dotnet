@inject AppState State

<main class="wrap">
    <header class="top">
        <h1>Mapping assist</h1>
        <p class="lede">Paste a source sample (XML or EDI-style segments) and describe the target. An assistant suggests which field goes where. Nothing is mapped until you approve it, and you can change the target or the conversion first.</p>
        <p class="notice" role="note"><strong>The model here is a stand-in.</strong> It compares field names (with a short built-in word list) and checks that a value looks like a date or a number. It does not understand meaning, so expect some wrong suggestions: that is what the Approve and Reject buttons are for.</p>
    </header>

    <section aria-label="Examples" class="presets">
        <span class="muted">Try an example:</span>
        <button type="button" class="chip" @onclick="() => Load(Samples.PartnerXml, Samples.InternalOrderSchema)">Partner XML &rarr; internal XML</button>
        <button type="button" class="chip" @onclick="() => Load(Samples.EdiOrder, Samples.InternalOrderSchema)">EDI order &rarr; internal XML</button>
        <button type="button" class="chip" @onclick="() => Load(Samples.PartnerXml, Samples.EdiSchema)">Partner XML &rarr; EDI order</button>
    </section>

    <section class="inputs">
        <div>
            <label for="src">Source sample</label>
            <textarea id="src" rows="14" spellcheck="false" @bind="sourceText" @bind:event="oninput"></textarea>
            <p class="muted small">Only the first of a repeated element or segment is read.</p>
        </div>
        <div>
            <label for="tgt">Target schema: <code>path | type | description</code></label>
            <textarea id="tgt" rows="14" spellcheck="false" @bind="targetText" @bind:event="oninput"></textarea>
            <p class="muted small">Type is string, number or date. Use /Order/Id for XML or N1.02 for an EDI element.</p>
        </div>
    </section>

    <div class="actions">
        <button type="button" class="primary" @onclick="Suggest" disabled="@busy">@(session is null ? "Suggest mappings" : "Suggest again")</button>
        @if (message is not null)
        {
            <span class="error" role="alert">@message</span>
        }
    </div>

    @if (session is not null)
    {
        <section aria-live="polite">
            <h2>Suggestions <span class="muted small">@session.Suggestions.Count(s => s.Status == SuggestionStatus.Pending) waiting, @session.Approved.Count approved</span></h2>
            @foreach (var s in session.Suggestions)
            {
                var sug = s;
                <article class="card @sug.Status.ToString().ToLowerInvariant()">
                    <div class="row">
                        <code class="path">@sug.SourcePath</code>
                        <span class="arrow" aria-hidden="true">&rarr;</span>
                        @if (sug.Status == SuggestionStatus.Pending)
                        {
                            <label class="sr" for="t@(sug.Id)">Target for @sug.SourcePath</label>
                            <select id="t@(sug.Id)" @onchange="e => targets[sug.Id] = e.Value?.ToString() ?? sug.TargetPath">
                                @foreach (var t in session.Target)
                                {
                                    <option value="@t.Path" selected="@(t.Path == TargetOf(sug))">@t.Path</option>
                                }
                            </select>
                            <label class="sr" for="x@(sug.Id)">Conversion</label>
                            <select id="x@(sug.Id)" @onchange="e => transforms[sug.Id] = e.Value?.ToString() ?? sug.Transform">
                                @foreach (var x in Transforms.Names)
                                {
                                    <option value="@x" selected="@(x == TransformOf(sug))">@x</option>
                                }
                            </select>
                        }
                        else
                        {
                            <code class="path">@sug.TargetPath</code>
                            <span class="tag">@sug.Transform</span>
                        }
                    </div>
                    <div class="row meta">
                        <span class="conf" title="Confidence">@((sug.Confidence * 100).ToString("0"))%</span>
                        <span class="muted">@sug.Rationale</span>
                    </div>
                    <div class="row buttons">
                        @if (sug.Status == SuggestionStatus.Pending)
                        {
                            <button type="button" class="ok" @onclick="() => Approve(sug)">Approve</button>
                            <button type="button" @onclick="() => Reject(sug)">Reject</button>
                        }
                        else
                        {
                            <span class="status">@sug.Status</span>
                            @if (sug.Status == SuggestionStatus.Approved)
                            {
                                <button type="button" @onclick="() => Withdraw(sug)">Withdraw</button>
                            }
                        }
                    </div>
                </article>
            }
            @if (session.Suggestions.Count == 0)
            {
                <p class="muted">No suggestions.</p>
            }

            @if (session.UnmappedTargets.Count > 0)
            {
                <p class="muted small">Not mapped yet: @string.Join(", ", session.UnmappedTargets.Select(t => t.Path))</p>
            }
        </section>

        <section aria-live="polite">
            <h2>Output from approved mappings</h2>
            @if (result is null || result.Values.Count == 0)
            {
                <p class="muted">Approve a suggestion to see the output.</p>
            }
            else
            {
                <pre class="out">@result.Output.Text</pre>
                @foreach (var w in result.Output.Warnings.Concat(result.Skipped))
                {
                    <p class="muted small">@w</p>
                }
            }
        </section>
    }

    <footer class="foot">
        <a href="https://github.com/hamzamehmood46/mapping-assist-dotnet">Source on GitHub</a>
        <span class="muted"> / The data is made up and nothing leaves your browser.</span>
    </footer>
</main>

@code {
    private string sourceText = Samples.PartnerXml;
    private string targetText = Samples.InternalOrderSchema;
    private string? message;
    private bool busy;
    private MappingSession? session;
    private ApplyResult? result;
    private string? loadedSource;
    private string? loadedTarget;
    private readonly Dictionary<int, string> targets = [];
    private readonly Dictionary<int, string> transforms = [];

    private string TargetOf(Suggestion s) => targets.GetValueOrDefault(s.Id, s.TargetPath);

    private string TransformOf(Suggestion s) => transforms.GetValueOrDefault(s.Id, s.Transform);

    private void Load(string source, string target)
    {
        sourceText = source;
        targetText = target;
        session = null;
        result = null;
        message = null;
        targets.Clear();
        transforms.Clear();
    }

    private async Task Suggest()
    {
        message = null;
        var src = SourceReader.Read(sourceText);
        var tgt = SchemaReader.Read(targetText);
        if (!src.Ok || !tgt.Ok)
        {
            message = src.Error ?? tgt.Error;
            return;
        }

        busy = true;
        if (session is null || loadedSource != sourceText || loadedTarget != targetText)
        {
            session = new MappingSession(src.Items, tgt.Items, State.Assistant);
            loadedSource = sourceText;
            loadedTarget = targetText;
            targets.Clear();
            transforms.Clear();
        }

        var r = await session.SuggestAsync();
        message = r.Ok ? null : r.Error;
        result = session.Apply();
        busy = false;
    }

    private void Approve(Suggestion s)
    {
        var r = session!.Approve(s.Id, TargetOf(s), TransformOf(s));
        message = r.Ok ? null : r.Error;
        result = session.Apply();
    }

    private void Reject(Suggestion s)
    {
        session!.Reject(s.Id);
        message = null;
    }

    private void Withdraw(Suggestion s)
    {
        session!.Unapprove(s.Id);
        result = session.Apply();
    }
}
